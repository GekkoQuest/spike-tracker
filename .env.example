# Copy to .env for production compose. Never commit real secrets.
APP_PORT=8080
POSTGRES_DB=spiketracker
POSTGRES_USER=spiketracker
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Match source
VLR_API_URL=https://vlr.orlandomm.net

# Security (comma-separated)
ALLOWED_ORIGINS=http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1
ADMIN_KEY=replace-with-a-long-random-admin-key

# Development only: uses a small clearly identified sample when the upstream is empty.
DEMO_MODE=false
